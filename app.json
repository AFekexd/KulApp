{
  "expo": {
    "name": "KulApp",
    "slug": "KulApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kulapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kulapp.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.kulapp.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PanicDrop",
              "label": "KulApp Panic Drop (1x1)",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "1-Click Instant Stool Recording",
              "previewImage": "./assets/images/icon.png"
            },
            {
              "name": "Dashboard",
              "label": "KulApp Throne Dashboard (2x2)",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Live Throne Streak & Daily Count",
              "previewImage": "./assets/images/icon.png"
            },
            {
              "name": "Streak",
              "label": "KulApp Streak (2x1)",
              "minWidth": "140dp",
              "minHeight": "60dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Keep your streak alive",
              "previewImage": "./assets/images/icon.png"
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d1836e8-3dd1-4bdf-9ae9-c6000e68105f"
      }
    }
  }
}
